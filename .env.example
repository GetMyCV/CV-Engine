# --- Accounts & cloud storage (optional) -------------------------------------
# Without these, CV Engine runs in "local workspace" mode: accounts and projects
# are stored in this browser only. With them, users sign up with email and their
# projects sync to Supabase Postgres (run supabase/migrations/*.sql first).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (New-style "sb_publishable_…" keys can go in either variable.)
# NEVER put the database password or the secret/service_role key in any NEXT_PUBLIC_ variable.

# --- AI writing assistant (optional) -----------------------------------------
# Server-side only. Enables "Improve with AI", summary/letter drafting and
# tailoring. Without it, the built-in offline writing helpers are used.
ANTHROPIC_API_KEY=

# --- Grammar checker (optional) ----------------------------------------------
# The built-in grammar & style checker runs offline. Set this to a LanguageTool
# server to add a deep spelling/grammar pass (users opt in per check).
# Public API: https://api.languagetool.org/v2/check  (rate limited)
LANGUAGETOOL_URL=

# Origins allowed to call /api/* cross-origin (the GitHub Pages site).
ALLOWED_ORIGINS=https://getmycv.github.io

# --- Access & client template requests -------------------------------------------
# Only these emails can sign in (comma-separated). Everyone else only ever sees
# the /choose template picker through a link the admin sends.
NEXT_PUBLIC_ADMIN_EMAILS=inbox.ashen@gmail.com
# Optional: Web3Forms access key — emails each client's template choice to the admin.
NEXT_PUBLIC_WEB3FORMS_KEY=
